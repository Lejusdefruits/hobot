Screen {
    background: $background;
}

TabbedContent {
    height: 1fr;
}

.pane {
    padding: 1 2;
    height: 1fr;
}

.pane-title {
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

.hint {
    color: $text-muted;
    margin-bottom: 1;
}

.card-row {
    height: auto;
    margin-bottom: 1;
}

.card {
    border: round $primary;
    padding: 1 2;
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.card:last-of-type {
    margin-right: 0;
}

.card-label {
    color: $text-muted;
}

.card-value {
    text-style: bold;
    color: $text;
}

.card-value.warn {
    color: $warning;
}

.card-value.good {
    color: $success;
}

.section {
    border: round $panel-lighten-2;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

#profile-edit-form {
    border: round $primary;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

#profile-edit-form Input {
    margin-bottom: 1;
}

.section-title {
    text-style: bold underline;
    margin-bottom: 1;
}

.button-row {
    height: auto;
    margin-top: 1;
}

.button-row Button {
    margin-right: 1;
}

#toggle-pause {
    width: 14;
}

DataTable {
    height: 1fr;
}

.detail-body {
    height: 1fr;
    border: round $primary;
    padding: 1 2;
}

.detail-label {
    color: $text-muted;
}

TextArea {
    height: 10;
    border: round $primary;
}

#chat-log {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

/* Textual's own default Vertical height is 1fr, not auto -- without this
   rule, the empty pending-sends container (tui/panes/chat.py) silently
   claimed half the pane's height for itself (split evenly with #chat-log's
   own 1fr), leaving the actual chat log's visible border stopping halfway
   down the pane instead of reaching the input row -- confirmed directly by
   measuring both widgets' regions. auto: zero height with no pending-send
   cards mounted, grows only to fit the ones that exist. */
#pending-sends {
    height: auto;
}

.chat-turn {
    margin-bottom: 1;
}

.chat-role-user {
    color: $accent;
    text-style: bold;
}

.chat-role-assistant {
    color: $success;
    text-style: bold;
}

.chat-input-row {
    height: auto;
    margin-top: 1;
}

#chat-input {
    width: 1fr;
}

.pending-send {
    border: round $warning;
    padding: 1 2;
    margin-top: 1;
    height: auto;
}

ConfirmModal {
    align: center middle;
}

ConfirmModal > Vertical {
    width: 60;
    height: auto;
    border: round $warning;
    background: $surface;
    padding: 1 2;
}

CvFilePickerModal {
    align: center middle;
}

CvFilePickerModal > Vertical {
    width: 80;
    /* A fixed height: 30 overflowed off-screen (buttons unreachable, not
       just visually clipped) on anything shorter than 30 rows, a classic
       80x24 terminal included -- confirmed directly. A share of the actual
       screen height instead, never taller than what's really there;
       #cv-tree's own 1fr still adapts to whatever that leaves it. */
    height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

CvFilePickerModal #cv-tree {
    height: 1fr;
}


OfferDetailScreen {
    align: center middle;
}

#offer-detail-body {
    width: 90%;
    height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    margin-bottom: 1;
}

.error-text {
    color: $error;
}

.danger-btn {
    background: $error;
}
