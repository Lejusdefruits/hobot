[Unit]
Description=hobot — job discovery + Discord bot (optional)
After=network-online.target ollama.service

[Service]
# Replace with the real path where you cloned the repo, then:
#   mkdir -p ~/.config/systemd/user && cp systemd/hobot.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now hobot
#   loginctl enable-linger $USER   # so it keeps running without a session open
# This unit runs the daemon only (scheduler + Discord) -- no terminal
# attached, so the terminal UI can't run here. Use `python cli.py` in your
# own terminal instead, whenever you want to look at something; it talks to
# the same database as this service.
WorkingDirectory=/path/to/hobot
ExecStart=/path/to/hobot/.venv/bin/python -u daemon.py

# Safety: caps RAM/CPU so a run that goes off the rails can never slow down
# or crash the rest of the machine.
MemoryMax=2G
CPUQuota=150%
Nice=10

# Restarts after a crash, but stops retrying after 5 failures in 10 minutes
# instead of looping indefinitely.
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=5

[Install]
WantedBy=default.target
