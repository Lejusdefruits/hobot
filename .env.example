# ============================================================
# hobot — configuration example (no secrets)
# Copy this file: cp .env.example .env, then fill in at least the REQUIRED section.
# Everything else is optional: an empty section just disables the matching
# feature, nothing breaks on startup.
# ============================================================

# ============================================================
# REQUIRED — an LLM, one way or another. Everything else in this file
# (including Discord) is optional: an empty section just disables the
# matching feature/interface, nothing breaks on startup.
# ============================================================

# LLM_PROVIDER picks which of the three blocks below actually answers.
# ollama (default) needs nothing else filled in below it and is the only
# fully free option. openai/anthropic need a real key but no local model to
# run -- pick this if you'd rather not install/run Ollama at all.
LLM_PROVIDER=ollama

# --- Local LLM (Ollama, https://ollama.com) ---
# ollama pull <model>, then ollama serve (or the equivalent system service)
OLLAMA_MODEL=qwen3.8
OLLAMA_HOST=http://localhost:11434
LLM_MAX_CONCURRENT=2

# RAM thresholds (GB) the install-time hardware scan (core/hardware.py, run by
# the guided setup wizard) uses to judge whether this machine can run
# OLLAMA_MODEL comfortably. Below the marginal floor, the wizard suggests a
# cloud LLM_PROVIDER instead (Groq's free tier is the usual pick -- only a
# Google account needed). RAM-only on purpose: GPU is shown for information
# but doesn't change the verdict, since a CPU-only box can still run a small
# model, just slower.
HOBOT_MIN_RAM_GB_COMFORTABLE=16
HOBOT_MIN_RAM_GB_MARGINAL=8

# Context window (tokens) requested from Ollama -- left to Ollama's own
# default/auto-shrunk-to-VRAM value, the chat agent's system prompt + ~37
# tool schemas alone measured over 6000 tokens before any conversation
# history, so a too-small default silently truncates the prompt: confirmed
# to make the model invent tool names that don't exist, and to leave replies
# empty or cut off mid-thought (the "why is hobot's chat giving me short,
# truncated answers" symptom). 20000 covers prompt + tools + full history
# (CHAT_AGENT_MAX_CONTEXT_TOKENS) + thinking + a real answer with room to
# spare; lower it only if your GPU can't spare the extra VRAM for a bigger
# KV cache.
OLLAMA_NUM_CTX=20000

# --- Cloud LLM (optional alternative to Ollama, only read if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Override to point at any OpenAI-compatible endpoint instead of OpenAI itself
# (OpenRouter, Groq, etc.) -- leave empty to use OpenAI's own API. Changing
# this alone isn't enough: OPENAI_MODEL above also has to match a model that
# actually exists on the new endpoint, or every call 404s with a
# model-not-found error. For Groq specifically: OPENAI_BASE_URL=
# https://api.groq.com/openai/v1 and OPENAI_MODEL=openai/gpt-oss-120b
# (verified working here); check console.groq.com/docs/models if that ever
# stops working, since Groq's lineup changes more often than OpenAI's or
# Anthropic's.
OPENAI_BASE_URL=

# --- Cloud LLM (optional alternative to Ollama, only read if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Visibility only, same /quotas surface as Adzuna/Hunter/Snov/Pappers/Tavily --
# never blocks a call. Shown only when LLM_PROVIDER is a cloud provider
# (openai/anthropic); irrelevant for Ollama, which is local and free. There's
# no real per-provider monthly cap to enforce here (pay-per-token, not
# pay-per-call), so this is just a number to watch, not a limit.
LLM_MONTHLY_QUOTA=10000

# --- Database / output files ---
HOBOT_DB_PATH=hobot.db
HOBOT_OUTPUT_DIR=outputs
# Conversation memory for /ask and the terminal UI's Chat pane -- a separate
# file from HOBOT_DB_PATH on purpose, so LangGraph's own internal locking
# never interacts with hobot's own transactions.
HOBOT_CHECKPOINT_DB_PATH=checkpoints.db

# ============================================================
# Discord (optional interface -- leave both empty to run without it; the
# terminal UI (cli.py) works either way, it's a separate process)
# ============================================================
# Discord bot: https://discord.com/developers/applications -> New Application ->
# Bot -> copy the token. DISCORD_CHANNEL_ID = right-click the channel -> Copy ID
# (enable developer mode in Discord settings first).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ============================================================
# Candidate profile (optional — a few equivalent ways to set it)
# ============================================================
# 1. /profile in Discord, attach a CV (PDF or .docx) -- reads it, saves the
#    profile, and follows up with questions if something looks thin or
#    missing.
# 2. CV_PATH + `python -m core.profile` from the command line (same reading
#    logic as /profile, no Discord round-trip).
# 3. No CV at all: just describe what you're looking for in plain language
#    via /ask -- the agent handles it.
# All three write to the same user_profile table -- no need to do more than one.
CV_PATH=
HOBOT_PROFILE_DIR=profile_source

# Per-offer CV tailoring (optional, needs a CV uploaded via /profile first):
# edits the summary paragraph (and, if the skills section is a plain text
# list, which real skills show) IN PLACE on your own uploaded CV -- same
# file, same layout, nothing else touched. Works out of the box for a PDF
# or .docx with a real text layer. A CV that's a fully flattened image (no
# extractable text at all -- common for some Canva "PDF for print" exports)
# gets a best-effort partial edit instead, flagged as such; there's no way
# around that without a real text layer somewhere in the file.
# .docx tailoring specifically needs LibreOffice installed (`soffice` on
# your PATH) to convert the result to PDF -- apt install libreoffice,
# brew install --cask libreoffice, or the Windows installer from
# libreoffice.org. Not needed for PDF CVs.
CV_TAILOR_SUMMARY_MAX_CHARS=500

# ============================================================
# Job discovery (JobSpy — scraping, no key needed)
# ============================================================

# indeed is the most reliable. linkedin was live-tested (2026-08-21) and does
# work -- real extra volume, often higher-quality/more-detailed listings than
# Indeed for the same search -- but JobSpy's own docs warn it rate-limits
# hard (around page 10) without a paid proxy, so it may stop returning
# results after a while; that's an accepted trade-off, not a bug to report.
# glassdoor and google are also supported by JobSpy but were found broken in
# this environment (glassdoor: location resolution fails outright; google:
# returns 0 results on every query tried, no CAPTCHA/consent wall involved --
# looks like a stale scraper for Google's current markup) -- see
# tools/sources_jobspy.py's docstring, don't bother enabling them without
# re-testing first. zip_recruiter is untested here.
JOBSPY_SITES=indeed,linkedin
JOBSPY_COUNTRY=France
JOBSPY_RESULTS_PER_RUN=25
JOBSPY_HOURS_OLD=48
JOBSPY_JITTER_MIN=90

# When discovery runs (local hours, cron) -- defaults line up with when new
# postings actually tend to appear (weekday mornings/early afternoons), not a
# blind interval that lands at 3am just as often as at 11am on a Tuesday. One
# scheduled job despite the two lines (weekday/weekend).
DISCOVERY_HOURS_WEEKDAY=9,11,13,15,17
DISCOVERY_HOURS_WEEKEND=10,16

DISCOVERY_MAX_SCORE_PER_RUN=40
DISCOVERY_HIGHLIGHT_SCORE=70
DISCOVERY_LETTER_SCORE_THRESHOLD=80
DISCOVERY_MAX_LETTERS_PER_RUN=5
DISCOVERY_MAX_COMPANY_SEARCHES_PER_RUN=10

# Optional: a new posting that the relevance pre-filter's keyword check
# (title, then description) can't decide on gets one more chance via
# semantic similarity (tools/semantic_relevance.py) instead of being
# dropped outright -- catches wording the profile itself never uses (e.g.
# "AI Engineer" against a profile that only ever says "IA"). Off by
# default: needs BOTH this flag AND `pip install sentence-transformers`
# (not installed by default -- see the "Job sources and search coverage"
# section of the README), which pulls in torch, the heaviest dependency
# this project would otherwise carry, for what's still just a pre-filter
# fallback ahead of the real (LLM) scoring step. The default model
# (RELEVANCE_SEMANTIC_MODEL, see tools/semantic_relevance.py) is a ~1.3GB
# French-specific one, not the smallest option available -- a lighter
# generic multilingual model was tried first and empirically failed to
# separate relevant from irrelevant postings for a real profile; this one
# was verified to actually work before being made the default.
RELEVANCE_SEMANTIC_FALLBACK=0
RELEVANCE_SIMILARITY_THRESHOLD=0.3

# Skip scoring (which calls the LLM) on a scheduled run when the machine is
# under heavy load -- so a scheduled discovery run doesn't compete with, say,
# a game, for CPU. Only applies to a local LLM_PROVIDER=ollama: a cloud API
# call doesn't run on this machine, so there's nothing to defer. Never
# affects an on-demand scoring request (chat, the TUI's "Score now" button)
# -- skipped offers just stay unscored and get picked up on the next run.
DISCOVERY_DEFER_ON_HIGH_LOAD=1
DISCOVERY_MAX_CPU_LOAD_FRACTION=0.85

# Dead-link cleanup (tools/link_check.py) -- conservative by design, see the
# module's docstring (only an unambiguous 404/410 marks an offer expired).
LINK_CHECK_STALE_DAYS=14
LINK_CHECK_RECHECK_DAYS=7
LINK_CHECK_MAX_PER_RUN=10
LINK_CHECK_TIMEOUT_SECONDS=8

# ============================================================
# French sources (optional — France/apprenticeship-only, leave empty to
# stay on JobSpy alone)
# ============================================================

# La Bonne Alternance (France Travail) -- apprenticeship only, free, key on
# https://api.gouv.fr (search "La Bonne Alternance").
LBA_API_KEY=

# Adzuna -- general-purpose, multi-country, free up to 2500 calls/month.
# Developer account on https://developer.adzuna.com/.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_MONTHLY_QUOTA=2500
ADZUNA_MAX_DAYS_OLD=6
# How many result pages to fetch per location/query (15 results/page) --
# 2 roughly doubles Adzuna volume for one extra call, still well inside the
# free monthly quota above.
ADZUNA_PAGES_PER_LOCATION=2

# France Travail Connect -- one client id/secret pair covers several APIs.
# Create an application on https://francetravail.io, subscribe to "Offres
# d'emploi v2" (works immediately), and to "La Bonne Boite v2" if you also
# want spontaneous-application leads (needs a manual approval from France
# Travail on top of the subscription -- until granted, this source just stays
# inactive without blocking anything else).
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Optional contract-type filter for "Offres d'emploi v2" (empty by default =
# every contract type). E1,E2 = professionalization + apprenticeship contracts
# (the two forms of French work-study); full code list on
# https://francetravail.io.
FRANCE_TRAVAIL_NATURE_CONTRAT=

# Optional: OAuth2 scope for "Marche du travail v1" (tools/marche_travail.py),
# used only as extra context when the AI picks search keywords (choose_keywords_node,
# graphs/discovery_graph.py) -- lets it tell a bad keyword apart from a
# genuinely tight job market. Find the exact scope name via the "eye" icon on
# the "Marche du travail v1" line at https://francetravail.io. Left empty, the
# keyword strategy still works, just without that extra signal.
FRANCE_TRAVAIL_MARCHE_SCOPE=

# ROME code(s) used by La Bonne Alternance and La Bonne Boite (a fixed France
# Travail taxonomy, not free-text) -- M1805 = IT/software by default, change
# it to match the target role (full ROME reference on https://francetravail.io).
# Comma-separate several codes to widen coverage to closely related roles
# (e.g. M1805,M1806,M1810 for IT dev + information-systems consulting +
# systems operations) -- both connectors pass this straight through to the
# API as-is.
LBA_ROME_CODES=M1805

# ============================================================
# ATS watchlist (optional — no key needed, but nothing happens without at
# least one company: unlike every other source above, Greenhouse/Ashby/Lever
# have no keyword search, only a per-company feed. See "Quality checks" and
# the ATS section in the README.)
# ============================================================

# Comma-separated company names, resolved to a working Greenhouse/Ashby/Lever
# board on first use and cached from then on -- add, remove, or list them
# later through chat (via /ask) without touching this file again.
ATS_WATCHLIST=

# How often (days) to check Maddyness/Frenchweb for a company that just
# raised funding and propose it as a watchlist addition -- always a
# proposal (a notification), never added automatically. See "Funding-news
# leads" in the README. No key needed, nothing to fill in to turn this on.
FUNDING_CHECK_INTERVAL_DAYS=2

# ============================================================
# Email (optional) — leave everything empty to disable mail monitoring entirely
# ============================================================

# Reads every account listed (add GMAIL_ACCOUNT_2/GMAIL_APP_PASSWORD_2, _3,
# etc. to watch more than one); only GMAIL_SEND_ACCOUNT may send or draft a
# reply. Password = a Google "app password", not your normal one (requires
# 2-step verification to be enabled).
GMAIL_ACCOUNT_1=
GMAIL_APP_PASSWORD_1=
GMAIL_SEND_ACCOUNT=

EMAIL_POLL_INTERVAL_MIN=20
EMAIL_POLL_JITTER_MIN=5
EMAIL_FETCH_LIMIT=10
IMAP_TIMEOUT_SECONDS=20
GMAIL_DAILY_SEND_CAP=15

# ============================================================
# Web search for letters/contacts (optional -- Tavily preferred, self-hosted
# SearXNG as fallback)
# ============================================================
# Without either configured, letters still get written (just without company
# enrichment) and company-contact lookups (via /ask) fall back to Pappers/
# Hunter/Snov alone.

# Tavily: a real search API, no ban risk -- used instead of SearXNG whenever
# a key is set here, since SearXNG queries real search engines on our behalf
# (see tools/web_search.py). Free plan: 1000 credits/month, 1 credit per
# search, no card required. https://tavily.com
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=10
TAVILY_MONTHLY_QUOTA=1000

# SearXNG: fallback only used when TAVILY_API_KEY isn't set (or Tavily is
# backed off/quota-exhausted) -- queries Google/Bing/DuckDuckGo/Qwant on our
# behalf, a real ban risk on repeated use, hence the fallback role.
# Start with: docker-compose up -d (uses searxng/settings.yml).
SEARXNG_HOST=http://localhost:8888
# Any random string — only used by docker-compose.yml to seed SearXNG's
# session secret, nothing to do with an API key.
SEARXNG_SECRET=
SEARXNG_TIMEOUT_SECONDS=10

# ============================================================
# Company-contact enrichment (optional, each one independent of the others)
# ============================================================

# Pappers: French legal company registry only.
# https://www.pappers.fr/api
# The free plan is commonly cited as 100 calls/month, but Pappers doesn't
# publish this as precisely as the others below -- check your actual plan on
# pappers.fr/api and adjust PAPPERS_MONTHLY_QUOTA if it differs.
PAPPERS_API_TOKEN=
PAPPERS_MONTHLY_QUOTA=100

# Hunter.io: verified emails by domain, any country.
# Free plan: 50 searches/month. https://hunter.io/api
HUNTER_API_KEY=
HUNTER_MONTHLY_QUOTA=50

# Snov.io: automatic fallback when Hunter comes up empty (separate quota).
# Free plan: 50 credits/month, no card required. https://snov.io/api
SNOV_USER_ID=
SNOV_API_SECRET=
SNOV_MONTHLY_QUOTA=50

# ============================================================
# Terminal UI (a second way to use hobot besides Discord -- run `python
# cli.py` in any terminal, no setup needed beyond the base install. Its own
# separate process, not a service: launch it whenever you want to look at
# something, close it when you're done. No host/port/token to configure --
# it never listens on the network, only you can ever reach it.)
# ============================================================
# The Chat pane uses its own fixed conversation by default, separate from
# any Discord user's -- point this at a real Discord user id instead if
# you'd rather the two interfaces share one conversation.
CLI_CHAT_THREAD_ID=cli

# ============================================================
# Misc
# ============================================================
WEEKLY_DIGEST_DAY=mon
WEEKLY_DIGEST_HOUR=9
# A cover-letter draft (status='draft', already has a letter) still pending
# after this many days gets called out in the weekly digest ("Drafts pending
# for more than N days") -- a nudge to go send it or drop it, nothing else
# changes on its own.
STALE_DRAFT_DAYS=5
# A proactive notification fires the first time a quota-limited API (Adzuna,
# Hunter.io, Snov.io, Pappers, Tavily) drops under this % of its monthly quota
# remaining, once per source per month -- checked at the end of every
# scheduled discovery run (core/api_usage.py::check_quota_alerts).
QUOTA_ALERT_THRESHOLD_PCT=10
AGENT_TIMEOUT_SECONDS=180
# How much recent chat history (tokens, approximate) gets sent to the LLM on
# every /ask or Chat pane turn -- the full conversation always stays in
# checkpoints.db regardless, this only bounds what's replayed to the model
# each time. Left empty on purpose: the code default already adapts to
# LLM_PROVIDER (6000 for Ollama, where OLLAMA_NUM_CTX is set generously
# enough to hold it alongside the system prompt + ~41 tool schemas at
# effectively no cost; 400 for any cloud provider -- measured directly
# against a real 429 from Groq's free tier: the ~41 tool schemas alone
# already use roughly 7000-7500 of its 8000-tokens/minute cap for
# openai/gpt-oss-120b, leaving only a few hundred tokens of real headroom,
# not the few thousand a higher default would assume. 400 effectively means
# no cross-turn memory on a tight cloud plan -- hobot's real state (offers,
# applications, profile) lives in the database either way, so most single
# self-contained requests are unaffected; it's specifically a follow-up
# referencing something said earlier in the same conversation that stops
# working. Set this explicitly to override, e.g. higher on a paid cloud
# plan with real headroom to spare.
CHAT_AGENT_MAX_CONTEXT_TOKENS=
# A posting open at least this many days gets flagged as a possible ghost
# job (advisory only, see "Quality checks" in the README) -- lower this if
# your postings tend to stay open briefly and 45 days feels too lenient.
GHOST_JOB_DAYS_THRESHOLD=45
